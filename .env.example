# --- OCR backend ---
# Which reader to use: "openai" (live vision model) or "mock" (keyless, fixed sample).
OCR_BACKEND=openai

# Required when OCR_BACKEND=openai. Billed separately from any Claude/ChatGPT plan.
OPENAI_API_KEY=sk-...

# --- Optional: contact vault (Airtable) ---
# Leave all three blank to disable the vault. Nothing is saved when disabled.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=

# --- Optional: simple login for the public Space ---
# If set, the app prompts for user "remko" + this password.
GRADIO_PASSWORD=
